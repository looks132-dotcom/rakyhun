# Cloud production service configuration. Never put real secrets in this file.
NODE_ENV=production
HOST=0.0.0.0
PORT=10000
MOONGLE_DATA_DIR=/var/data/moongle
PUBLIC_URL=https://your-service.onrender.com
TRUST_PROXY=true
MOONGLE_INITIAL_INVITE=replace-with-a-random-secret-at-least-16-characters
# Optional Google OAuth:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_DOMAIN=
